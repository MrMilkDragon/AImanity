{
  "name": "ai-phone",
  "private": true,
  "version": "0.0.1",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -p scripts/tsconfig.json",
    "proto:check": "buf lint && buf build",
    "proto:generate": "buf generate",
    "smoke:protocol": "bun scripts/smoke-protocol.ts",
    "check": "bun run proto:check && bun run typecheck && cargo check --workspace --locked"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@bufbuild/buf": "1.75.0",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "typescript": "7.0.2",
    "@types/bun": "1.4.4"
  },
  "license": "Apache-2.0"
}
