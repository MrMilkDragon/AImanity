#!/bin/sh
set -eu
project_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -x "$project_root/runtime/services/bin/host" ]; then
  exec "$project_root/runtime/services/bin/host" --project-command "$project_root" "$@"
fi
exec cargo run --quiet --locked --manifest-path "$project_root/Cargo.toml" -p ai-phone-host-runtime --bin host-resources -- --project-command "$project_root" "$@"
